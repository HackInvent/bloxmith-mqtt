{
  "kind": "mqtt",
  "version": "0.1.0",
  "title": "MQTT",
  "description": "Exchange bounded JSON or text messages with an explicitly configured external MQTT broker.",
  "repository_url": "https://github.com/HackInvent/bloxmith-mqtt",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "Linux/POSIX, Python 3.10+ with paho-mqtt 2.1.0 installed; configured MQTT 3.1.1 broker and trusted TLS CA certificates."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "publish",
        "title": "publish",
        "accepts": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "command",
        "title": "command",
        "accepts": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "message",
        "title": "message",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "status",
        "title": "status",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "broker_host": "",
    "broker_port": 8883,
    "tls": true,
    "secret_ref": "",
    "ca_file": "",
    "subscriptions": [],
    "publish_topics": [],
    "payload_format": "json",
    "qos": 1,
    "allow_retained": false,
    "clean_session": true,
    "client_id": "",
    "keepalive_sec": 30,
    "connect_timeout_sec": 10,
    "reconnect_attempts": 3,
    "reconnect_delay_sec": 2,
    "max_payload_bytes": 16384,
    "max_queue": 32,
    "max_messages_per_sec": 50
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "file_browser": true,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
